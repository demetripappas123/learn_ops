# ============================================================================
# CertForge Studio — environment template
# Copy this file to `.env` (which is gitignored) and fill in values:
#     cp .env.example .env
# Leave everything blank / false to run the fully local, deterministic demo.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) Azure AI Search  =  the "Foundry IQ" grounding for retrieval
#    Set USE_FOUNDRY_IQ=true to make the Learning Curator, Builder Coach, and
#    Assessment agents retrieve from Azure AI Search instead of local Markdown.
#    (Run scripts/index_knowledge.py once to populate the index.)
# ---------------------------------------------------------------------------
USE_FOUNDRY_IQ=false
# Endpoint from the search service "Overview" page, e.g.
#   https://my-search.search.windows.net
AZURE_SEARCH_ENDPOINT=
# Index name created by scripts/index_knowledge.py (default below)
AZURE_SEARCH_INDEX_NAME=certforge-knowledge
# OPTIONAL: an Azure AI Search API key (Settings > Keys). Use a QUERY key for the
# app; the indexing script needs an ADMIN key. Leave BLANK to use keyless
# Microsoft Entra auth (your `az login` locally, managed identity in Azure).
AZURE_SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# 2) Azure OpenAI in Foundry Models  =  OPTIONAL LLM agent enrichment
#    Set USE_FOUNDRY_LLM=true to let the Builder Coach expand concept
#    explanations with a deployed chat model. Always falls back to the
#    deterministic text if the model/endpoint is unavailable.
# ---------------------------------------------------------------------------
USE_FOUNDRY_LLM=false
# e.g. https://my-aoai.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
# The DEPLOYMENT name you gave the model in Foundry (not the model name), e.g. gpt-4o
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# OPTIONAL: Azure OpenAI API key ("Keys and Endpoint" blade). Leave BLANK to use
# keyless Microsoft Entra auth.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
